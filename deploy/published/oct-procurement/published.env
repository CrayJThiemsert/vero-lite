# Pinned environment for the PUBLISHED procurement system (PLAN-0103 Step 4b).
# This file is COMMITTED and carries NO SECRETS — it is AC-4's parse target.
#
# ⚠️ The filename is deliberately NOT `.env.published`. `.gitignore:22` ignores
# `.env.*`, so that name would be silently untracked and AC-4 would parse a file
# that does not exist in a fresh checkout.
#
# ⚠️ API_KEYS IS NOT HERE AND MUST NEVER BE. It maps sha256(raw-key) -> person_id
# and is a secret (CLAUDE.md §8). See README.md — and note that on THIS system the
# intended posture is that it is never provisioned at all (see the view set below).

# --- which surface this process serves --------------------------------------- #
UI_PROFILE=published

# --- which tabs this system publishes (PLAN-0103 Step 2) ---------------------- #
# Ordered; the FIRST key is this system's default landing tab. Validated at boot
# against the ten-tab census (services/api/static/assets/app.js ALL_VIEWS) — an
# unknown key refuses the process rather than serving a tab set it cannot render.
#
# RULED by Cray (SD-3/SD-4 joint ruling, typed s218): `G,F`, default **G**, and
# NO personas. This system's story is the governed hero; the approve beat is
# fleet's, and the three OCT features are energy's.
#
# ⚠️ DEFAULT IS G, NOT A, AND THAT IS LOAD-BEARING. Tab A is structurally blank on
# this vertical: the registered adapter is `FastenalCsvAdapter`, whose
# `stream_events` is an empty async iterator by design ("the CSV demo dataset
# ships no OperationalEvent stream (v1)",
# verticals/procurement/data_adapter/fastenal_csv.py:248-251). Landing a cold
# visitor on an empty map is the one first impression this surface cannot afford.
#
# The eight NOT published here, each on its own basis:
#   A  the adapter streams no events — structurally blank (above)
#   B  reads the same empty stream
#   C  /query is assisted; this system's story is the hero, not NL query
#   D  flow view rides Tab A's data
#   E  the three intake routes are off the allowlist            D5(2)
#   H  its routes are DB-backed and this system is DB-LESS      LOCKED-1 + SD-3
#   I  the api-cases routes are DB-backed                       LOCKED-1
#   J  the api-exports routes are DB-backed                     LOCKED-1
#
# ⚠️ H IS STORAGE-BLOCKED, NOT PERSONA-BLOCKED, and the distinction decides
# whether it may ever come back here. SD-3 corrected the original `G,F,H` draft on
# exactly this point: Tab H's backing run is written through `async_session`
# (main.py:334-357), and LOCKED-1 keeps procurement DB-less. H returns to this
# system only if Cray revises LOCKED-1 — not by re-reading the persona question.
UI_PUBLISHED_VIEWS=G,F

# --- the active vertical ------------------------------------------------------ #
# System #2 is PROCUREMENT (ADR-0036 D4). One process serves exactly one vertical:
# every route reads settings.oct_vertical, /meta returns it as a single string, and
# auth resolves principals within it. A second vertical is a SECOND compose project
# (ADR-0035 L9/D4), not a setting.
#
# This is the vertical that OWNS the governed hero — routers/demo.py dispatches the
# hero builders per vertical and procurement is the one that has them
# (verticals/procurement/hero_demo/). Energy's system denies the two hero reads at
# its edge for precisely this reason; here they are the point.
OCT_VERTICAL=procurement

# ⚠️ NO OCT_RECOMMEND_* HERE, AND THE ABSENCE IS DELIBERATE — not an omission
# copied past from energy's file. Those five settings drive the deterministic
# recommender over `reading` events, which feeds Tab A. This system publishes no
# Tab A and its adapter streams no events, so every one of them would be a pinned
# value that nothing on this surface reads. Pinning them anyway would tell the next
# reader they are load-bearing here. They are not.
#
# (Energy's file pins none either — its config defaults ARE energy's. A vertical
# that publishes Tab A over a non-`Asset` entity is the case that must set them.)

# --- auth (fail-closed) -------------------------------------------------------- #
# ⚠️ TRUE, AND ON THIS SYSTEM NOBODY IS EXPECTED TO LOG IN AT ALL. SD-3/SD-4 ruled
# this system "anonymous read + hero, no personas", and `^/whoami$` is
# correspondingly OFF this system's allowlist — see cloudflared/config.yml's header
# for the full reasoning and the one open UI question it leaves.
#
# Keeping auth ENABLED rather than off is the fail-closed direction: with it true
# and no API_KEYS provisioned, every keyed route refuses. Setting it false would
# open them to anyone.
API_AUTH_ENABLED=true

# --- LLM ------------------------------------------------------------------------ #
# host.docker.internal reaches MS-S1's Ollama over the LAN. It resolves via the
# compose file's extra_hosts on the Linux engine; ADR-0035 D1(2) keeps the Ollama
# endpoint LAN-only — it is never published, proxied, or tunneled.
#
# This system publishes no assisted route (no Tab C, and the hero's default is the
# offline fixture), so in practice it should not call MS-S1 at all. The cap is
# pinned anyway: PLAN-0103 Step 4's aggregate posture is "1 in-flight PER SYSTEM",
# and a system that inherits an unpinned 0 = UNLIMITED would silently void it.
OLLAMA_HOST=http://host.docker.internal:11434
LLM_REQUEST_TIMEOUT_S=25
LLM_RETRY_BUDGET=1
LLM_MAX_INFLIGHT=1

# --- prompt log (ADR-0035 D6) --------------------------------------------------- #
# 90-day rolling, Cray-only reader, 30-day DSR honor, and NO IP / headers / gate
# identity stored. The path is the `prompt-log` named volume's mount point, so the
# rows survive a container replace. Enabled even though no assisted route is
# published here: if one is ever added, the obligation must already be in force
# rather than remembered.
PROMPT_LOG_ENABLED=true
PROMPT_LOG_DIR=/var/log/vero/prompt-log

# --- tenancy (ADR-0035 D7) ------------------------------------------------------ #
# The customer organisation this process serves, stamped on every persisted row.
# All three published systems are the one demo tenant.
TENANT_ID=demo

# --- demo seeding --------------------------------------------------------------- #
# 🔴 OFF, AND THIS IS THE SYSTEM WHERE IT ACTUALLY MATTERS. main.py:348 gates the
# operate-demo seed on `vertical == "procurement"` and :353 on this setting, so
# unlike energy's file — where the pin is inert twice over — this pin is the only
# thing keeping the seed off here.
# (PLAN-0103 SD-3/SD-5 cite this gate as `main.py:329`; the code has since moved to
#  :348. Verified against the file s220 — the gate itself is unchanged.)
#
# The seed writes a waiting_human run through `async_session`, and this deployment
# has no Postgres (LOCKED-1). The seed block is fail-soft, so leaving it on would
# not break the boot; it would log a warning on every start and seed nothing.
OCT_DEMO_SEED_OPERATE=false

# --- app ------------------------------------------------------------------------- #
LOG_LEVEL=INFO
ENVIRONMENT=published
