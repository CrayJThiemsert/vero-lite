# Pinned environment for the PUBLISHED fleet-maintenance system (PLAN-0103 Step 4b).
# This file is COMMITTED and carries NO SECRETS — it is AC-4's parse target.
#
# ⚠️ The filename is deliberately NOT `.env.published`. `.gitignore:22` ignores
# `.env.*`, so that name would be silently untracked and AC-4 would parse a file
# that does not exist in a fresh checkout.
#
# ⚠️ NEITHER API_KEYS NOR THE DATABASE PASSWORD IS HERE, AND NEITHER MAY EVER BE.
# Both are secrets (CLAUDE.md §8) and both are passed through from the host
# environment by the compose file. See README.md for provisioning.

# --- which surface this process serves --------------------------------------- #
UI_PROFILE=published

# --- which tabs this system publishes (PLAN-0103 Step 2) ---------------------- #
# Ordered; the FIRST key is this system's default landing tab. Validated at boot
# against the ten-tab census (services/api/static/assets/app.js ALL_VIEWS) — an
# unknown key refuses the process rather than serving a tab set it cannot render.
#
# RULED by Cray (SD-3, typed s218): `A,C,F,H,I,J`, default **A**. Cray's six
# favourites minus E (its narrative moves portal-side, LOCKED-3) plus **F**, which
# was a drafter addition Cray adopted with "เอา F" — the ladder the personas climb
# is READ in Procedures, and hiding it weakens the refused-then-granted beat.
#
# This is the system that tells the APPROVAL story. It is the only published
# system with personas (LOCKED-5) and the only one with a database (LOCKED-1),
# and those two facts are why H, I and J are here and nowhere else.
#
# The four NOT published here:
#   B  the anomaly detail rides Tab A's selection; not a separate published beat
#   D  the flow view is energy's three-feature story, not this system's
#   E  the three intake routes are off the allowlist            D5(2) + LOCKED-3
#   G  the governed hero is BESPOKE PER DESIGN PARTNER (ADR-0032 D1.2) and belongs
#      to the procurement system. `_fleet_governance` does exist in routers/demo.py,
#      but it refuses `live=true` rather than faking it, and SD-3 gave this system
#      the approve beat instead of the hero. One system, one story.
UI_PUBLISHED_VIEWS=A,C,F,H,I,J

# --- the active vertical ------------------------------------------------------ #
# System #3 is FLEET_MAINTENANCE (ADR-0036 D4). One process serves exactly one
# vertical: every route reads settings.oct_vertical, /meta returns it as a single
# string, and auth resolves principals within it.
#
# ⚠️ Bring-up order is procurement THEN fleet (SD-2, Cray typed s218), and fleet's
# bring-up additionally gates on AC-11's RoPA (ADR-0037 D2.1). Authoring this file
# is NOT gated — ADR-0037 is Accepted.
OCT_VERTICAL=fleet_maintenance

# --- the deterministic recommender (Tab A's content) -------------------------- #
# 🔴 THESE FIVE MUST BE SET HERE, AND INHERITING THE DEFAULTS WOULD BREAK THE DEMO
# ON ITS OWN LANDING TAB. The config defaults are ENERGY's (threshold 90.0, above,
# Asset / asset_id, "over-temperature"). This vertical's `measured_value` is a
# repair quote in THB, and its readings are ฿1,800 / ฿2,400 / ฿3,200 / ฿15,000 /
# ฿48,000 — so under a threshold of 90.0 ALL FIVE would breach and Tab A, the
# default landing view, would open on five anomalies.
#
# The real boundary is the ฿5,000 DOA ceiling: at or below it the head mechanic
# decides alone and nothing enters the approval chain; above it the ladder engages
# (verticals/fleet_maintenance/data_adapter/synthetic.py — every routine row says
# "ต่ำกว่าเพดาน 5,000 บาท ช่างใหญ่เคาะเองได้").
#
# At 5000.0/above exactly TWO readings breach, and that is the fixture's design
# intent, not a coincidence: ฿15,000 routes to วิรัช (ผจก.เดินรถ) and ฿48,000 to
# the owner. Its own docstring says why — "Two breaches, two different tiers: the
# demo shows the ladder ROUTING, which a single-breach fixture cannot."
OCT_RECOMMEND_THRESHOLD=5000.0
OCT_RECOMMEND_DIRECTION=above
OCT_RECOMMEND_ENTITY_TYPE=Truck
OCT_RECOMMEND_ENTITY_ID_FIELD=truck_id
OCT_RECOMMEND_LABEL=over-ceiling repair quote

# --- auth (fail-closed) -------------------------------------------------------- #
# 🔴 THIS IS THE SYSTEM WHERE LOGIN IS THE POINT. LOCKED-5: three demo personas,
# one API key each, so the audit trail records the persona actually chosen rather
# than one anonymous identity. `^/whoami$` is ON this system's allowlist for
# exactly that reason (it is OFF procurement's, which takes no personas).
#
# The principals are authored in verticals/fleet_maintenance/procedures.yaml with a
# real authority ladder: req-mechanic-tom (ต้อม, requester),
# appr-fleet-manager-wirat (วิรัช, approver), and the owner tier.
#
# With auth enabled and no API_KEYS provisioned the demo still boots and serves
# every unkeyed route — but the approve beat, which is this system's whole story,
# is unreachable. Provisioning is a bring-up step, not an optional extra.
API_AUTH_ENABLED=true

# --- LLM ------------------------------------------------------------------------ #
# host.docker.internal reaches MS-S1's Ollama over the LAN; ADR-0035 D1(2) keeps
# the Ollama endpoint LAN-only — never published, proxied, or tunneled.
#
# ⚠️ This system publishes Tab C, so it is the SECOND assisted published system.
# PLAN-0103 Step 4 measured the hazard that would matter — model-eviction thrash
# between systems pinning different models — and found it ABSENT: no committed
# file overrides recommender_model / ollama_default_model, so every system serves
# the same gpt-oss:20b. What remains is plain concurrency, bounded per system by
# the cap below (over-cap FAILS FAST to the deterministic arm with the PLAN-0093
# disclosure rather than queueing).
#
# 🔴 TRIPWIRE, named so nobody re-alarms and re-measures: the day any per-system
# env introduces a recommender_model / OLLAMA_DEFAULT_MODEL override, eviction
# thrash returns and this posture is reopened.
OLLAMA_HOST=http://host.docker.internal:11434
LLM_REQUEST_TIMEOUT_S=25
LLM_RETRY_BUDGET=1
LLM_MAX_INFLIGHT=1

# --- prompt log (ADR-0035 D6) --------------------------------------------------- #
# 90-day rolling, Cray-only reader, 30-day DSR honor, and NO IP / headers / gate
# identity stored. The path is the `prompt-log` named volume's mount point.
#
# ⚠️ ADR-0035 D6 is the PROMPT-LOG regime and does not reach this system's other
# personal-data surface: Tab I is visitor-writable and its free text persists to
# THIS system's Postgres. That is a separate processing activity with its own
# retention question and its own DSR path — it is AC-11's RoPA obligation, and it
# gates this system's BRING-UP (ADR-0037 D2.1). See README.md.
PROMPT_LOG_ENABLED=true
PROMPT_LOG_DIR=/var/log/vero/prompt-log

# --- tenancy (ADR-0035 D7) ------------------------------------------------------ #
# The customer organisation this process serves, stamped on every persisted row.
# All three published systems are the one demo tenant — and on this system the
# stamp reaches real database rows rather than only the prompt log.
TENANT_ID=demo

# --- demo seeding --------------------------------------------------------------- #
# ⚠️ FALSE HERE, AND THAT IS NOT THE END OF THE STORY. SD-5 ruled (a): seed one
# waiting run at boot AND keep the visitor path, so Tab H is never empty at the
# moment the demo must not look dead.
#
# But main.py gates the existing operate-demo seed on `vertical == "procurement"`,
# so it does nothing here no matter what this value is. Fleet's seed is PLAN-0103
# **Step 7** and is not built yet; this pin is set false so the flag means what it
# says today rather than implying a seed that does not exist.
# 🔴 Step 7 must flip this AND add fleet's own seed — changing this line alone
# would be a no-op that reads like a fix.
OCT_DEMO_SEED_OPERATE=false

# --- app ------------------------------------------------------------------------- #
LOG_LEVEL=INFO
ENVIRONMENT=published
