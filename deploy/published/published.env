# Pinned environment for the PUBLISHED OCT demo (PLAN-0100 §Pinned values).
# This file is COMMITTED and carries NO SECRETS — it is AC-4's parse target.
#
# ⚠️ The filename is deliberately NOT `.env.published`. `.gitignore:22` ignores
# `.env.*`, so that name would be silently untracked and AC-4 would parse a file
# that does not exist in a fresh checkout.
#
# ⚠️ API_KEYS IS NOT HERE AND MUST NEVER BE. It maps sha256(raw-key) -> person_id
# and is a secret (CLAUDE.md §8). Provision it env-local on the host — see
# README.md in this directory. With API_AUTH_ENABLED=true and no API_KEYS the
# demo boots but NOBODY CAN LOG IN, and keyless /whoami returns 401 (which is the
# correct, and Step 9-asserted, behaviour — 200 there would mean auth is off).

# --- which surface this process serves --------------------------------------- #
UI_PROFILE=published

# --- the active vertical ------------------------------------------------------ #
# System #1 is ENERGY (Cray, typed, 2026-08-06). One process serves exactly one
# vertical: every route reads settings.oct_vertical, /meta returns it as a single
# string, and auth resolves principals within it. A second vertical is a SECOND
# compose project (ADR-0035 L9/D4), not a setting.
#
# Energy earns system #1 on measured grounds, not preference:
#   * its adapter STREAMS reading events, so /recommendations is non-empty — the
#     procurement CSV adapter's stream_events is an empty iterator by design
#     ("v1"), which would leave Tab A, the default landing view, blank;
#   * the DB-less boot guarantee was verified for energy by independent review;
#   * the OCT_RECOMMEND_* defaults below ARE energy's, so nothing is overridden.
OCT_VERTICAL=energy

# ⚠️ DO NOT ADD OCT_RECOMMEND_* HERE. The config defaults (threshold 90.0,
# direction above, Asset / asset_id, "over-temperature") are energy's own, and the
# synthetic dataset is built around them: exactly ONE reading (96.5 °C) breaches
# and every other reading is deliberately held below 90. Overriding any of them
# changes what Tab A shows. A DIFFERENT vertical's project must set them.

# --- auth (fail-closed) -------------------------------------------------------- #
API_AUTH_ENABLED=true

# --- LLM ------------------------------------------------------------------------ #
# host.docker.internal reaches MS-S1's Ollama over the LAN. It resolves via the
# compose file's extra_hosts on the Linux engine; ADR-0035 D1(2) keeps the Ollama
# endpoint LAN-only — it is never published, proxied, or tunneled.
OLLAMA_HOST=http://host.docker.internal:11434
LLM_REQUEST_TIMEOUT_S=25
LLM_RETRY_BUDGET=1
# The global in-flight cap. Default is 0 = UNLIMITED and no committed file set it
# before this one, so the published demo's "1" existed only as PLAN prose until
# Step 8. Over the cap a request FAILS FAST to the deterministic arm with the
# PLAN-0093 disclosure rather than queueing. This is what actually bounds MS-S1 —
# the per-IP Cloudflare rule bounds visitors, this bounds the box.
LLM_MAX_INFLIGHT=1

# --- prompt log (ADR-0035 D6) --------------------------------------------------- #
# 90-day rolling, Cray-only reader, 30-day DSR honor, and NO IP / headers / gate
# identity stored. The path is the `prompt-log` named volume's mount point, so the
# rows survive a container replace.
PROMPT_LOG_ENABLED=true
PROMPT_LOG_DIR=/var/log/vero/prompt-log

# --- tenancy (ADR-0035 D7) ------------------------------------------------------ #
# The customer organisation this process serves, stamped on every persisted row.
# The public demo is its own tenant.
TENANT_ID=demo

# --- demo seeding --------------------------------------------------------------- #
# OFF. The operate-demo seed writes a waiting_human run through async_session, and
# this deployment has no Postgres (SD-1). The seed block is fail-soft so leaving it
# on would not break the boot — it would just log a warning every start. It is also
# procurement-only (main.py gates it on the vertical), so it is inert here twice
# over; pinned explicitly so the procurement system does not inherit an accident.
OCT_DEMO_SEED_OPERATE=false

# --- app ------------------------------------------------------------------------- #
LOG_LEVEL=INFO
ENVIRONMENT=published
